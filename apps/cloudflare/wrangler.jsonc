// =============================================================================
//  The Circularity Repair Cafe Hub on Cloudflare
//  ---------------------------------------------------------------------------
//  One Worker serves the whole site: the pages, the API, the photos and the
//  hourly jobs. See docs/install.md for how to set one up.
//
//  Nothing in this file is about one particular cafe, so it works as it is
//  and you do not need to edit it.
// =============================================================================
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "repair-cafe-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // The web app's static files: scripts, styles, fonts and images. Requests
  // for these are answered by Cloudflare directly, without running the Worker,
  // so they cost no CPU time at all.
  "assets": {
    "directory": "../web/.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },

  // The cafe's own web address is not set here, so this file works for any
  // cafe. Pass it the first time you publish instead:
  //   pnpm cf:deploy -- --domain repair.example.org
  // Cloudflare then creates the DNS record and the HTTPS certificate. The
  // domain must already be on your Cloudflare account. Until then the hub is
  // also reachable at <name>.<your-subdomain>.workers.dev.
  "workers_dev": true,

  // The database and the file bucket. No ids are written here: the first
  // `wrangler deploy` creates both on your account and remembers them.
  "d1_databases": [{ "binding": "DB", "database_name": "repair-cafe-hub" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "repair-cafe-hub-uploads" }],

  // The hourly jobs (telemetry if agreed, the update check, refreshing the
  // Repair Cafe directory) run after ordinary visits, so no cron trigger is
  // needed. The free plan allows only five per account. If you have one to
  // spare, add  "triggers": { "crons": ["17 * * * *"] }  here as well.
  // See src/housekeeping.ts.

  // Settings such as TZ (where your cafe is) are not written here. Set them in
  // the Cloudflare dashboard: Workers & Pages, repair-cafe-hub, Settings,
  // Variables and Secrets. Every setting has a sensible default, and
  // "keep_vars" stops a publish from wiping what you set there. Keeping them
  // out of this file also means `git pull` never trips over your changes.
  // The settings are listed in docs/running-your-hub.md.
  "keep_vars": true,

  // Bundle .wasm (the picture renderer) and .ttf (its fonts) as modules.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  "observability": { "enabled": true },

  // The project's public demo site, published with  pnpm demo:deploy.  It has
  // its own Worker, database and bucket, so it never touches a real cafe. It
  // also needs a secret, DEMO_RESET_KEY, which lets demo/seed.py wipe and refill
  // it every hour. See docs/demo.md. A cafe can ignore this section.
  "env": {
    "demo": {
      "name": "repair-cafe-demo",
      "d1_databases": [{ "binding": "DB", "database_name": "repair-cafe-demo" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "repair-cafe-demo-uploads" }],
      "vars": {
        "TZ": "Europe/London",
        "DEMO_MODE": "true",
        "TELEMETRY_DISABLED": "true",
        "UPDATE_CHECK_DISABLED": "false"
      }
    }
  }
}
