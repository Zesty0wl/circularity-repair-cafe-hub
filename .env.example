# Copy this file to `.env` and fill in real values before `docker compose up`.
#
# REQUIRED: 32+ character random string used to sign JWT access/refresh tokens.
# Generate with:  openssl rand -hex 32
SECRET_KEY=please-change-me-32-or-more-random-chars

# Your local time. Event times, session dates and reports all use this. Set it
# to where your cafe actually is, or every time shown on the site will be out.
# The installer fills this in from the machine's own clock.
# A full list of names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# Optional: the port on this machine that the hub listens on. Change it only if
# something else already uses 5026.
# HUB_PORT=5026

# Optional: which published image to run. Leave it out and you get `latest`,
# which is the newest release. Set a version number to stay on one release
# until you choose to move, for example:
# HUB_VERSION=1.5.0

# Optional: rule out sharing anonymous numbers with the project for this whole
# install, before anybody is asked. Leave unset and the setup wizard asks, with
# nothing sent until someone says yes.
# TELEMETRY_DISABLED=true

# Optional: stop the hub asking GitHub once a day whether a newer version has
# been released. It sends nothing about your cafe either way, but set this to
# true and no request is made at all.
# UPDATE_CHECK_DISABLED=true
