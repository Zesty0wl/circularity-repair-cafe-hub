{
  "name": "@circularity/cloudflare",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "The hub: the API on Cloudflare Workers, D1 and R2, wrapped round the SvelteKit app.",
  "scripts": {
    "build:web": "pnpm --filter @circularity/shared build && pnpm --filter @circularity/web build",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "pnpm build:web && wrangler deploy",
    "deploy:demo": "pnpm build:web && wrangler deploy --env demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@circularity/shared": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.44.0"
  }
}
