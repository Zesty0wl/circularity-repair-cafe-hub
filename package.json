{
  "name": "circularity-hub",
  "version": "1.4.1",
  "private": true,
  "description": "Circularity Repair Cafe Hub - self-hosted repair cafe management",
  "license": "MIT",
  "homepage": "https://circularity.org/repair-cafe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zesty0wl/circularity-repair-cafe-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Zesty0wl/circularity-repair-cafe-hub/issues"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "scripts": {
    "build:shared": "pnpm --filter @circularity/shared build",
    "build:web": "pnpm --filter @circularity/web build",
    "build:server": "pnpm --filter @circularity/server build",
    "build": "pnpm build:shared && pnpm build:web && pnpm build:server",
    "dev:server": "pnpm --filter @circularity/server dev",
    "dev:web": "pnpm --filter @circularity/web dev"
  },
  "engines": {
    "node": ">=22"
  }
}
